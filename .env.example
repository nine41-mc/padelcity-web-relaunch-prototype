# PadelCity website prototype – data sources.
# Copy to .env.local and fill in. Never commit real values (.env*.local is gitignored).
# Missing vars → silent fallback to mock data.

# Contentful Delivery API (read-only; clubs, courts, facilities, coaches)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT_ID=master
CONTENTFUL_DELIVERY_TOKEN=

# Google Places API (New) – club reviews module, read at build time only (see src/lib/data/README.md)
GOOGLE_PLACES_API_KEY=

# App deep links (Adjust / go.link host)
NEXT_PUBLIC_ADJUST_BASE=

# Set by CI for GitLab Pages sub-path hosting; leave empty locally
NEXT_PUBLIC_BASE_PATH=
